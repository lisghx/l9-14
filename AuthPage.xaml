<Page x:Class="Тужилова_Чудо_Обувь.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Тужилова_Чудо_Обувь"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontFamily="Comic Sans MS">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="175"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Логин" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"></TextBlock>
        <TextBox Name="TBoxLogin" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextChanged="TBoxLogin_TextChanged" Width="200" FontSize="15"></TextBox>

        <TextBlock Text="Пароль" Grid.Column="0" Grid.Row="1" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5"></TextBlock>
        <TextBox Name="TBoxPassword" Grid.Column="1" Grid.Row="1" TextChanged="TBoxPassword_TextChanged" Width="200" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Top"></TextBox>
        
        <Button Content="Войти как гость" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Name ="GuestView" Click="GuestView_Click" Margin="10"></Button>
        <Button Content="Авторизация" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Name="AuthView" Click="AuthView_Click" Margin="10"></Button>

        <StackPanel x:Name="CaptchaPanel" Orientation="Horizontal" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Name="captchaOneWord" FontSize="22" Margin="30,0,0,0"></TextBlock>
            <TextBlock Name="captchaTwoWord" FontSize="22" TextDecorations="Strikethrough"></TextBlock>
            <TextBlock Name="captchaThreeWord" FontSize="22" TextDecorations="Strikethrough"></TextBlock>
            <TextBlock Name="captchaFourWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,10,0,0"></TextBlock>
            <TextBox Name="TBCInput" Width="100" Margin="10,0,0,0"></TextBox>
            <Button Name="RefreshC" Content="Обновить" Click="RefreshC_Click" Margin="5,0,0,0"></Button>
        </StackPanel>
    </Grid>
</Page>
